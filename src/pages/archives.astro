---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate);

const years = [...new Set(posts.map(p => p.data.pubDate.getFullYear()))]
  .sort((a, b) => b - a);
---

<BaseLayout title="Archivos — Franco Lamas" description="Posts por año">
  <Sidebar />
  <div class="main-wrap">
    <main class="container">
      <header class="page-header">
        <h1>Archivos</h1>
        <p class="text-muted">{years.length} años · {posts.length} posts</p>
      </header>
      <nav class="archives-nav">
        <ul class="archives-list">
          {years.map(year => (
            <li>
              <a href={`/archives/${year}`} class="archive-link">
                {year}
                <span class="archive-count">
                  {posts.filter(p => p.data.pubDate.getFullYear() === year).length}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <section class="post-list">
        {posts.map((post) => (
          <article class="post-card">
            <a href={`/blog/${post.id}`} class="post-card-link">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <ul class="tag-list">
                {post.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </a>
          </article>
        ))}
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: 3rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .page-header h1 {
    font-size: 1.6rem;
    margin: 0 0 0.4rem;
    color: var(--text-heading);
  }
  .text-muted {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 300;
    margin: 0;
  }
  .archives-nav {
    margin: 1.5rem 0;
    padding: 0;
  }
  .archives-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }
  .archive-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border-radius: 4px;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
    transition: all 0.15s;
  }
  .archive-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .archive-count {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 300;
  }
  .post-list {
    padding: 0;
  }
  .post-card {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .post-card:last-child {
    border-bottom: none;
  }
  .post-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .post-card time {
    color: var(--text-muted);
    font-size: 0.8rem;
    display: block;
    margin-bottom: 0.25rem;
  }
  .post-card h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.4rem;
    color: var(--text-heading);
    line-height: 1.3;
  }
  .post-card:hover h2 {
    color: var(--accent);
  }
  .post-card p {
    color: var(--text-muted);
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    font-weight: 300;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tag-list li {
    display: inline-block;
    font-size: 0.7rem;
    background: rgba(52, 158, 243, 0.1);
    color: var(--accent);
    padding: 0.08rem 0.5rem;
    border-radius: 3px;
  }
</style>
