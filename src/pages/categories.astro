---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate);
---

<BaseLayout title="Categorías — Franco Lamas" description="Categorías del blog">
  <Sidebar />
  <div class="main-wrap">
    <div class="container">
      <header class="page-header">
        <h1>Categorías</h1>
        <p class="text-muted">{new Set(posts.map(p => p.data.category)).size} categorías en total</p>
      </header>
      <section class="category-list-section">
        {Array.from(new Set(posts.map(p => p.data.category)))
          .sort((a, b) => a.localeCompare(b))
          .map(category => {
            const filtered = posts.filter(p => p.data.category === category);
            return (
              <div class="category-group">
                <h2 class="category-name">{category}</h2>
                <ul class="post-list">
                  {filtered.map(post => (
                    <li class="post-item">
                      <a href={`/blog/${post.id}`} class="post-link">
                        <time datetime={post.data.pubDate.toISOString()} class="post-date">
                          {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
                        </time>
                        <span class="post-title">{post.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
      </section>
    </div>
    <Footer />
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .page-header h1 {
    font-size: 1.8rem;
    margin: 0 0 0.4rem;
    color: var(--text-heading);
  }
  .text-muted {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 300;
    margin: 0;
  }
  .category-group {
    margin-bottom: 2.5rem;
  }
  .category-name {
    font-size: 1.3rem;
    color: var(--text-heading);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-item {
    margin-bottom: 0.8rem;
  }
  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 0.5rem 0;
    border-radius: 4px;
    transition: background 0.15s;
  }
  .post-link:hover {
    background: rgba(255, 255, 255, 0.03);
  }
  .post-date {
    display: block;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 300;
    margin-bottom: 0.2rem;
  }
  .post-title {
    font-size: 1rem;
    color: var(--text-heading);
    font-weight: 500;
  }
  .post-link:hover .post-title {
    color: var(--accent);
  }
</style>
