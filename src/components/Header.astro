---
// Header — solo barra superior de navegación
// Sidebar extraído a Sidebar.astro
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path ? 'active' : '';
---

<header class="site-header">
  <div class="nav">
    <a href="/" class={isActive('/') ? 'nav-logo' : ''} aria-label="Inicio">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
    </a>
    <div class="nav-links-mobile-toggle">
      <button id="sidebar-open" class="sidebar-open-btn" aria-label="Abrir menú">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const openBtn = document.getElementById('sidebar-open');
  const sidebar = document.getElementById('sidebar');
  if (openBtn && sidebar) {
    openBtn.addEventListener('click', () => {
      sidebar.classList.add('open');
    });
  }
</script>
