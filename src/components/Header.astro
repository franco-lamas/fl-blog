---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path ? 'active' : '';
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-profile">
    <h4 class="sidebar-profile-name">Franco Lamas</h4>
    <p class="sidebar-profile-bio">Tecnología por naturaleza.</p>
  </div>
  <nav class="sidebar-nav">
    <ul>
      <li><a href="/" class={isActive('/')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Inicio
      </a></li>
      <li><a href="/blog" class={isActive('/blog')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        Blog
      </a></li>
      <li><a href="/about" class={isActive('/about')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        Acerca de
      </a></li>
      <li><a href="/rss.xml">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        RSS
      </a></li>
    </ul>
  </nav>
  <div class="sidebar-theme">
    <button id="theme-toggle" class="theme-toggle">
      <svg class="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <span class="theme-label">Cambiar tema</span>
    </button>
  </div>
</aside>

<button class="sidebar-close" id="sidebar-close" aria-label="Cerrar menú">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <line x1="18" y1="6" x2="6" y2="18"></line>
    <line x1="6" y1="6" x2="18" y2="18"></line>
  </svg>
</button>

<script>
  const sidebar = document.getElementById('sidebar');
  const closeBtn = document.getElementById('sidebar-close');
  const themeBtn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  // Theme toggle
  const saved = localStorage.getItem('theme') || 'dark';
  root.setAttribute('data-theme', saved);

  themeBtn.addEventListener('click', () => {
    const current = root.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  // Mobile sidebar close
  closeBtn.addEventListener('click', () => {
    sidebar.classList.remove('open');
  });

  document.addEventListener('click', (e) => {
    if (!sidebar.contains(e.target as Node) && !closeBtn.contains(e.target as Node)) {
      sidebar.classList.remove('open');
    }
  });
</script>

<style>
  .icon-moon { display: none; }
  [data-theme='dark'] .icon-sun { display: none; }
  [data-theme='dark'] .icon-moon { display: inline; }
</style>
