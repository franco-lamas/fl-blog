---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, image } = post.data;
const formattedDate = pubDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <a href={`/blog/${post.id}`} class="post-card-link">
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    <h2>{title}</h2>
    <p>{description}</p>
    {image && <img src={image} alt="" class="post-card-img" loading="lazy" />}
    <ul class="tag-list">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  </a>
</article>
